# ========================================================
# BaseIndex Agent - Environment Configuration
# Base Mainnet (Chain ID: 8453)
# ========================================================

# ----------------- Server & Agent Config -----------------
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# OpenAI API Key (gpt-4o)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Coinbase Developer Platform (CDP) AgentKit (Base Mainnet)
CDP_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
CDP_API_KEY_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
CDP_WALLET_DATA="" # Optional: JSON string representation of exported wallet data

# Base Mainnet RPC
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453

# Telegram Trading Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_WEBHOOK_URL=https://your-render-url.onrender.com/api/telegram/webhook

# Execution Safeguards
MAX_SLIPPAGE_BPS=50 # 0.50% maximum allowable slippage
MAX_SINGLE_TRADE_USD=10000

# ----------------- Frontend Web Config -----------------
NEXT_PUBLIC_APP_NAME="BaseIndex Agent"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="b4916a49594f83e20e854d924151e39a"
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_API_URL=http://localhost:4000
